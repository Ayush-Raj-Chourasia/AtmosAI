{
  "name": "weathernexus",
  "version": "1.0.0",
  "description": "WeatherNexus — National Weather Big Data Analytics Platform (SIH26069)",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "22.x",
    "npm": ">=10.0.0"
  },
  "private": true,
  "bin": {
    "weathernexus": "./nweis-cli.mjs",
    "nweis": "./nweis-cli.mjs"
  },
  "scripts": {
    "start": "node server-nweis.mjs",
    "serve": "node server-nweis.mjs",
    "test": "node test-nweis.mjs",
    "test:nweis": "node test-nweis.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "simulate": "node simulate-stream.mjs",
    "simulate:once": "node simulate-stream.mjs --once",
    "demo": "node simulate-stream.mjs --once",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/reset.mjs",
    "cli": "node nweis-cli.mjs",
    "package": "powershell.exe -ExecutionPolicy Bypass -File .\\package-release.ps1",
    "build": "turbo build",
    "dev": "concurrently -n \"WEB,API\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev -w apps/web\" \"npm run dev -w apps/api\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "lint": "turbo lint",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "prettier": "^3.4.0",
    "turbo": "^2.3.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.23.0"
  }
}
