# =============================================================================
# N-WEIS: National Weather Event Intelligence System
# SIH26069 — Ministry of Earth Sciences / India Meteorological Department (IMD)
# Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO REPOSITORY
# =============================================================================

# -----------------------------------------------------------------------------
# CORE DATABASE (PostgreSQL 16 + PostGIS)
# When configured, PostgreSQL/PostGIS is the authoritative database.
# When absent, system runs with atomic disk persistence (data/nweis-store.json).
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://nweis:nweis_secure_password_2026@localhost:5432/nweis_db

# -----------------------------------------------------------------------------
# REDIS (Distributed Queue & Real-Time Coordination)
# Used for background jobs, rate limits, and cross-worker coordination.
# If unavailable or connection fails, system explicitly reports: REDIS = DEGRADED.
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# GOOGLE GEMINI AI (Multimodal Reasoning, Misinformation & Classification)
# Used for image validation, damage assessment, claim cross-referencing.
# Evaluated strictly server-side. Never exposed to browser or client bundles.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# IMD OFFICIAL API (National Met Centre Warnings & Bulletins)
# Official IMD API Portal: https://api.imd.gov.in/public/index.php
# Modes: LIVE (valid only on verified API response), REPLAY, MOCK, DEGRADED, OFFLINE.
# -----------------------------------------------------------------------------
IMD_API_KEY=
IMD_ENDPOINT_URL=https://api.imd.gov.in/v1/warnings

# -----------------------------------------------------------------------------
# X / TWITTER API v2 (Social Weather Signal Stream)
# Used to query #IMD, #weather, #rain, #flood, #thunderstorm, #heatwave, etc.
# Validates bearer token. If missing -> REPLAY. If token fails -> DEGRADED.
# -----------------------------------------------------------------------------
TWITTER_BEARER_TOKEN=
TWITTER_API_BASE_URL=https://api.x.com/2

# -----------------------------------------------------------------------------
# OPENWEATHER API (Secondary Weather Provider)
# Used as secondary corroboration alongside Open-Meteo and IMD.
# Failures are non-fatal and accurately reflected in source health.
# -----------------------------------------------------------------------------
OPENWEATHER_API_KEY=

# -----------------------------------------------------------------------------
# GOOGLE MAPS / GEOCODING (Optional)
# Leaflet/OpenStreetMap works natively without this.
# Only used for resolving ambiguous gazetteer place names when needed.
# If unresolved, coordinates remain null (no fake pins).
# -----------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# CLOUDFLARE R2 OBJECT STORAGE (Citizen Media Evidence)
# S3-compatible bucket for disaster photos/videos.
# When unconfigured, uses local demo storage and reports: MEDIA STORAGE = DEMO/LOCAL.
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# -----------------------------------------------------------------------------
# ADMIN & FORECASTER AUTHENTICATION (RBAC)
# Roles: PUBLIC, CITIZEN, ANALYST, ADMIN. Enforced strictly server-side.
# -----------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
ADMIN_EMAIL=duty.meteorologist@imd.gov.in
ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# APPLICATION RUNTIME CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
