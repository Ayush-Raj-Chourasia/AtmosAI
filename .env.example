# N-WEIS: National Weather Event Intelligence System
# SIH 2026 Problem Statement: SIH26069 (Ministry of Earth Sciences / IMD)
# Environment Configuration Template

# Server Port (Default: 3001)
PORT=3001

# Server Bind Host (Default: 0.0.0.0)
HOST=0.0.0.0

# Node Environment
NODE_ENV=production

# Base URL for stream simulator and client callbacks
NWEIS_URL=http://localhost:3001

# Operational Authority Identifiers
ALERT_ISSUER_OID=2.49.0.0.356.0.nweis
ALERT_SENDER_AUTHORITY=nwfc-alert@imd.gov.in
REGIONAL_SEOC_HELPLINE=1077
NATIONAL_EMERGENCY_HELPLINE=112
